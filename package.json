{
  "name": "home-page",
  "author": "杏团 (Almochi)",
  "github": "https://github.com/Almochi/Home",
  "home": "https://almochi.cn",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "description": "基于 Material 3 Expressive 设计令牌的个人引导页",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "design:lint": "node scripts/check-design.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src scripts",
    "format": "biome format --write src scripts",
    "check": "pnpm typecheck && pnpm design:lint && pnpm lint"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/simple-icons": "^1.2.95",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright-core": "^1.63.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
